---
/*
 * The self-service flow, implemented and verified end to end (see the
 * portal and Orchestrator READMEs). Numbered because it is a sequence.
 */
const steps = [
	{
		title: 'Fill in a form',
		where: 'Backstage portal',
		text: 'New Tenant or New Postgres database. Owner teams come from the GitHub org.',
	},
	{
		title: 'A pull request opens',
		where: 'instances repository',
		text: "Under the developer's own GitHub identity, with the claim and its catalog entity.",
	},
	{
		title: 'CI validates the claim',
		where: 'GitHub Actions',
		text: 'Against the platform APIs. A typo or a missing field fails the pull request, not the cluster.',
	},
	{
		title: 'Argo CD syncs it',
		where: 'after merge',
		text: 'Git is the source of truth. A manual change on the cluster is reverted.',
	},
	{
		title: 'Crossplane provisions',
		where: 'compositions',
		text: 'Namespace, guardrails, OpenBao namespace, database. The portal shows each resource.',
	},
];
---

<ol class="flow">
	{
		steps.map((s) => (
			<li>
				<p class="title">{s.title}</p>
				<p class="where">{s.where}</p>
				<p class="text">{s.text}</p>
			</li>
		))
	}
</ol>

<style>
	.flow {
		list-style: none;
		counter-reset: step;
		padding: 0;
		margin: 1.5rem 0 0;
		display: grid;
		gap: 0;
		border-top: 1px solid var(--idpk-line);
	}
	@media (min-width: 56rem) {
		.flow {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}
	}
	.flow li {
		counter-increment: step;
		margin: 0;
		padding: 1rem 1rem 1.25rem 0;
		border-bottom: 1px solid var(--idpk-line);
	}
	@media (min-width: 56rem) {
		.flow li {
			border-bottom: 0;
			padding-right: 1.25rem;
		}
		.flow li + li {
			padding-left: 1.25rem;
			border-left: 1px solid var(--idpk-line);
		}
	}
	.flow li::before {
		content: counter(step);
		display: block;
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--sl-color-accent);
		margin-bottom: 0.5rem;
	}
	.flow p {
		margin: 0;
	}
	.title {
		font-weight: 650;
		color: var(--sl-color-white);
		line-height: 1.3;
	}
	.where {
		font-size: 0.82rem;
		color: var(--sl-color-gray-3);
		margin-top: 0.15rem !important;
	}
	.text {
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		margin-top: 0.6rem !important;
	}
</style>
